########################################
# Security
########################################

# Required outside Development. The password for logging in to the app. Use a long random one,
# such as: openssl rand -base64 24
ADMIN_PASSWORD=

# How many days a login lasts (default 30). A visit in the second half of that renews it for the
# full period.
# SESSION_DAYS=30

# Required outside Development. The host names you reach the app by, separated by semicolons.
# Requests for any other host are rejected. localhost is always allowed.
ALLOWED_HOSTS=sitechecker.lan

# The reverse proxies in front of the app, if any: IP addresses or CIDR ranges, separated by
# semicolons. Their forwarded client address and scheme are believed, so the login cookie is Secure
# behind a proxy serving HTTPS, and login attempts are limited per client rather than per proxy.
# TRUSTED_PROXIES=172.18.0.0/16

# Required with Docker Compose. Shared by the app and the Scrape Worker, which only runs scripts in
# requests that carry it. Generate one with: openssl rand -hex 32
SCRAPE_WORKER_SECRET=

# Docker Compose only: the group that owns the Docker socket, which the socket proxy runs as.
# 0 (the default) is right for Docker Desktop; on Linux use: getent group docker | cut -d: -f3
# DOCKER_GID=0


########################################
# PIA VPN Configuration
########################################

# Required in order to use the PIA VPN container.
PIA_USERNAME="your_pia_username"
PIA_PASSWORD="your_pia_password"

# Set LOCAL_NETWORK to allow connections to the VPN container from your
# host during local development. The value must be the CIDR of the
# network your host traffic originates from inside Docker:
#   macOS (Docker Desktop): usually 192.168.65.0/24  (VM gateway)
#   Linux (native Docker):  the Compose bridge subnet, e.g. 172.19.0.0/16
# To find it, check your Docker subnet settings in Docker Desktop at
# "Settings > Resources > Network" or run this command:
#   docker run --rm alpine sh -c "getent hosts host.docker.internal | awk '{print \$1}'"
# then connect to localhost:3001 and note the source IP.
# LOCAL_NETWORK=192.168.65.0/24


########################################
# Browserless Configuration
########################################

BROWSERLESS_TOKEN="some_random_token"

# Use these environment variables to specify the URLs for the browserless
# instances when using the browserless containers.
#BROWSERLESS_URL=ws://localhost:3000
#BROWSERLESS_URL_VPN=ws://localhost:3001


########################################
# Scraping
########################################

# How long a scrape may run, in seconds, for Sites without their own timeout (default 120).
# SCRAPE_TIMEOUT=120

# When Browserless ends a session, in milliseconds (default 180000). Docker Compose passes it to
# both Browserless containers; a scrape timeout must leave 10 seconds under it for the screenshot.
# BROWSERLESS_TIMEOUT=180000

# Local development only: run scripts in a locally running Scrape Worker instead of in the app
# (see docs/local-development.md). Docker Compose sets it for you.
# SCRAPE_WORKER_URL=http://localhost:5280

# Seed the demo Sites into an empty database (default: only in Development).
# SEED_DEMO_DATA=true


########################################
# Pushover Configuration
########################################

# Using these environment variables, you can enable Pushover notifications for site check results.
# PUSHOVER_TOKEN="your_pushover_token"
# PUSHOVER_USER="your_pushover_user"


########################################
# Discord Configuration
########################################

# Using this environment variable, you can enable Discord notifications for site check results.
# DISCORD_TOKEN="your_discord_token"


########################################
# Healthchecks Configuration
########################################

# Using this environment variable, you can enable Healthchecks pings for uptime monitoring.
# HEALTHCHECKS_URL="your_healthchecks_url"
