<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SiteChecker.Scripting</AssemblyName>
    <PackageId>SiteChecker.Scripting</PackageId>
    <IsPackable>true</IsPackable>
    <Description>The contract SiteChecker Script Scrapers compile against: IScript, ScriptContext, ScriptOutcome and the Playwright helpers available to scripts.</Description>
    <Authors>Chase Pietrangelo</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/chasepie/site-checker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chasepie/site-checker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

</Project>
